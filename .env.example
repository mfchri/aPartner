# ========================================================
# Glass Chat – Environment Variables
# ========================================================

# [REQUIRED] Google Gemini API Key from Google AI Studio:
# Get yours for free at https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# [REQUIRED in Production] The single passcode to unlock your private chat app:
APP_PASSCODE=change_this_to_your_secure_passcode

# [OPTIONAL / RECOMMENDED] 32+ character secret for signing authentication cookies (JWT):
# If omitted, it will derive from APP_PASSCODE.
# Generate one with: openssl rand -base64 32
AUTH_SECRET=your_random_32_character_secret_here

# [OPTIONAL] Gemini Model Configuration:
# Default model (free-tier Flash):
GEMINI_MODEL=gemini-3.8-flash
# Comma-separated allowed models the client can select in Settings:
GEMINI_ALLOWED_MODELS=gemini-3.8-flash,gemini-3.8-flash-lite,gemini-3.5-flash,gemini-2.0-flash,gemini-1.5-flash

# [REQUIRED in Production for Rate Limiting] Upstash Redis credentials:
# Get a free database at https://upstash.com/
# In local development only, missing Upstash credentials falls back to in-memory rate limiting.
# In production, missing Upstash credentials will fail closed for security.
UPSTASH_REDIS_REST_URL=https://your-upstash-database.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_redis_rest_token_here
